import sys
sys.stdout.reconfigure(encoding="utf-8")

import matplotlib.pyplot as plt
import pandas as pd
import arabic_reshaper
from bidi.algorithm import get_display

def fa(text):
    return get_display(arabic_reshaper.reshape(str(text)))

plt.rcParams["font.family"] = "Tahoma"

# ۱. خواندن دیتا
dataset = pd.read_csv("info.csv")

# ۲. شمردن تعداد هر برند
brand_counts = dataset["brand"].value_counts()   # .head(10) اگه خواستی فقط ۱۰ تا

# ۳. آماده‌سازی برای نمودار
names = [fa(b) for b in brand_counts.index]
amount = list(brand_counts.values)

# ۴. رسم
plt.figure(figsize=(10, 6))
plt.bar(names, amount)
plt.title(fa("تعداد سفارش هر برند"))
plt.xticks(rotation=45, ha="right")
plt.tight_layout()
plt.show()
