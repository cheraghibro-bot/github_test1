import os
import datetime

# ==============================================================
# 1) مسیر و پوشه‌ی فعلی
# ==============================================================
print(os.getcwd())            # مسیر پوشه‌ای که برنامه الان توش اجرا میشه
print(os.listdir())           # لیست فایل‌ها و پوشه‌های همین مسیر
print(os.listdir("."))        # همون قبلی؛ "." یعنی پوشه‌ی فعلی
print(os.name)                # نوع سیستم: 'nt' = ویندوز ، 'posix' = لینوکس/مک

# ==============================================================
# 2) ساخت پوشه
# ==============================================================
os.mkdir("test")                                  # ساخت یک پوشه (اگه وجود داشته باشه خطا میده)
os.makedirs("test/a/b/c", exist_ok=True)          # ساخت پوشه‌ی تودرتو؛ exist_ok=True یعنی اگه بود خطا نده

# ==============================================================
# 3) ساخت فایل و نوشتن توش (این بخش از خود open هست نه os)
# ==============================================================
with open("test/hello.txt", "w", encoding="utf-8") as f:
    f.write("سلام دنیا")

# ==============================================================
# 4) تغییر پوشه‌ی کاری
# ==============================================================
os.chdir("test")              # وارد پوشه‌ی test میشیم
print(os.getcwd())
os.chdir("..")                # یه پوشه برمی‌گردیم عقب

# ==============================================================
# 5) بررسی وجود و نوع مسیر
# ==============================================================
print(os.path.exists("test"))              # آیا وجود داره؟ True/False
print(os.path.isdir("test"))               # آیا پوشه هست؟
print(os.path.isfile("test/hello.txt"))    # آیا فایل هست؟

# ==============================================================
# 6) کار با آدرس‌ها (os.path)
# ==============================================================
p = os.path.join("test", "a", "file.txt")  # چسبوندن امن مسیرها (برای هر سیستمی درست کار میکنه)
print(p)
print(os.path.basename(p))                 # فقط اسم فایل: file.txt
print(os.path.dirname(p))                  # فقط مسیر پوشه: test/a
print(os.path.splitext(p))                 # جدا کردن پسوند: ('test/a/file', '.txt')
print(os.path.abspath("test"))             # مسیر کامل (absolute)
print(os.path.getsize("test/hello.txt"))   # حجم فایل به بایت

# ==============================================================
# 7) اطلاعات فایل (stat)
# ==============================================================
info = os.stat("test/hello.txt")
print(info.st_size)                                        # حجم به بایت
print(datetime.datetime.fromtimestamp(info.st_mtime))      # زمان آخرین ویرایش
print(datetime.datetime.fromtimestamp(info.st_ctime))      # زمان ساخت (ویندوز) / تغییر متادیتا (لینوکس)

# ==============================================================
# 8) تغییر نام و جابه‌جایی
# ==============================================================
os.rename("test/hello.txt", "test/salam.txt")   # تغییر اسم فایل
os.rename("test/salam.txt", "test/a/salam.txt") # جابه‌جا کردن فایل به پوشه‌ی دیگه (rename هم میتونه move کنه)

# ==============================================================
# 9) پیمایش همه‌ی پوشه‌ها و زیرپوشه‌ها
# ==============================================================
for root, dirs, files in os.walk("test"):
    print("پوشه:", root)
    print("  زیرپوشه‌ها:", dirs)
    print("  فایل‌ها:", files)

# ==============================================================
# 10) روش سریع‌تر برای لیست کردن (scandir)
# ==============================================================
with os.scandir("test") as entries:
    for e in entries:
        print(e.name, "| پوشه است؟", e.is_dir(), "| فایل است؟", e.is_file())

# ==============================================================
# 11) متغیرهای محیطی و اطلاعات سیستم
# ==============================================================
print(os.environ.get("PATH"))               # مقدار متغیر محیطی PATH
print(os.environ.get("HOME"))               # پوشه‌ی کاربر (در ویندوز: USERPROFILE)
print(os.path.expanduser("~"))              # پوشه‌ی home کاربر در هر سیستمی
print(os.cpu_count())                       # تعداد هسته‌های پردازنده
print(os.getpid())                          # شماره‌ی پردازش فعلی
print(os.sep)                               # جداکننده‌ی مسیر در این سیستم ( \ یا / )

# ==============================================================
# 12) اجرای دستور سیستم
# ==============================================================
os.system("echo salam")                     # اجرای دستور ترمینال
# os.system("cls")                          # پاک کردن صفحه در ویندوز
# os.system("clear")                        # پاک کردن صفحه در لینوکس/مک

# ==============================================================
# 13) حذف (حواست باشه حذف برگشت نداره!)
# ==============================================================
os.remove("test/a/salam.txt")               # حذف یک فایل
os.rmdir("test/a/b/c")                      # حذف پوشه‌ی خالی (اگه خالی نباشه خطا میده)
os.removedirs("test/a/b")                   # حذف پوشه‌های خالیِ تودرتو از داخل به بیرون

# حذف پوشه‌ای که محتوا داره → باید از shutil استفاده کنی
import shutil
shutil.rmtree("test")                       # حذف کامل پوشه با همه‌ی محتوا

# ==============================================================
# 14) الگوی امن: قبل از ساخت/حذف چک کن
# ==============================================================
folder = "my_folder"

if not os.path.exists(folder):
    os.mkdir(folder)
    print("ساخته شد")
else:
    print("از قبل وجود داشت")

if os.path.exists(folder):
    os.rmdir(folder)
    print("حذف شد")

# ==============================================================
# 15) پیدا کردن همه‌ی فایل‌های یک پسوند خاص (مثلاً .py)
# ==============================================================
for root, dirs, files in os.walk("."):
    for name in files:
        if name.endswith(".py"):
            print(os.path.join(root, name))
